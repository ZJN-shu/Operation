# 复制本文件为 .env，并填上你的 MySQL root 密码
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=你的mysql密码
MYSQL_DB=ops_portal

# 会话 token 签名用（本地演示，可不动）
SECRET_KEY=dev-secret-change-me

# ---------- 进阶配置（都有安全默认值，不填也能跑） ----------
# 会话 TTL（分钟）：空闲超时 + 绝对超时；0 = 不限（兼容旧行为）。
# SESSION_IDLE_MINUTES=30
# SESSION_ABSOLUTE_MINUTES=480
# 迁移与启动分离：本地开发保持 1（启动即建表）；容器部署由一次性 migrate 服务置 0。
# RUN_MIGRATIONS=1

# ---------- 图片直传阿里云 OSS（默认关，不配也能跑；配齐 5 项才启用） ----------
# 只走服务端签受限直传凭证 + 前端直传，应用不经手文件体；未引入 oss2（标准库签名）。
# OSS_ENABLED=1
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_BUCKET=your-bucket
# OSS_ACCESS_KEY_ID=你的AK
# OSS_ACCESS_KEY_SECRET=你的SK
# 读图用的公开/CDN 基址（不配则列表不展示图片，仅存 key）：
# OSS_PUBLIC_BASE_URL=https://cdn.example.com
# OSS_MAX_UPLOAD_BYTES=10485760
# OSS_UPLOAD_EXPIRE_SECONDS=300
